generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model EnvironmentCheck {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

model Group {
  id       Int       @id @default(autoincrement())
  name     String
  members  Member[]
  expenses Expense[]
}

model Member {
  id       Int       @id @default(autoincrement())
  name     String
  groupId  Int
  group    Group     @relation(fields: [groupId], references: [id])
  expenses Expense[]
  shares   Share[]

  @@index([groupId])
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  amountCents Int
  createdAt   DateTime @default(now())
  groupId     Int
  group       Group    @relation(fields: [groupId], references: [id])
  payerId     Int
  payer       Member   @relation(fields: [payerId], references: [id])
  shares      Share[]

  @@index([groupId])
}

model Share {
  expenseId   Int
  expense     Expense @relation(fields: [expenseId], references: [id])
  memberId    Int
  member      Member  @relation(fields: [memberId], references: [id])
  amountCents Int

  @@id([expenseId, memberId])
}
